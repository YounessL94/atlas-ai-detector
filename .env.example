# Public (inlined at build time — set in Vercel BEFORE building)
NEXT_PUBLIC_SITE_URL=https://atlaslab-forensics.vercel.app
NEXT_PUBLIC_SITE_NAME=Atlas Forensics
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server secrets (never commit real values)
# Hive:
# - HIVE_API_KEY: self-serve V3 key (thehive.ai -> Service API Keys). Powers IMAGE and VIDEO detection.
#   Default V3 quota is ~100 requests/day, hence DAILY_GLOBAL_LIMIT=90.
# - HIVE_TEXT_API_KEY: V2 Enterprise project key for "AI-Generated Text Detection" (required for the TEXT detector;
#   not available self-serve).
# - HIVE_IMAGE_API_KEY: optional V2 Enterprise image project key (takes precedence over HIVE_API_KEY).
HIVE_API_KEY=
HIVE_TEXT_API_KEY=
HIVE_IMAGE_API_KEY=
# Self-serve AI text detection (EN/FR...) used when HIVE_TEXT_API_KEY is not set.
# dev.gowinston.ai -> API key. Billed 1 credit per word (prepaid credits).
WINSTON_API_KEY=
# Accounts: project-specific public key only. Never use a service/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep disabled until custom SMTP and end-to-end confirmation are verified.
ACCOUNTS_SIGNUP_ENABLED=0
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Long random string, e.g. `openssl rand -hex 32`
RATE_LIMIT_SALT=
GOOGLE_SITE_VERIFICATION=

# Optional abuse/cost caps (defaults shown)
DAILY_IP_LIMIT=40
DAILY_GLOBAL_LIMIT=90
DAILY_TEXT_GLOBAL_LIMIT=4
# Cumulative reserved Winston words (no expiry). Raise only after funding credits.
TEXT_TOTAL_WORD_BUDGET=2000

# Local dev only: deterministic fake results when no Hive key (ignored in production)
# HIVE_MOCK=1
